        "# Cell 2: Mengimpor library NumPy dan mendefinisikan matriks koefisien serta konstanta\n",
        "import numpy as np\n",
        "\n",
        "print(\"=== INISIALISASI SISTEM PERSAMAAN LINEAR TIGA VARIABEL ===\")\n",
        "# Contoh SPLTV:\n",
        "# 2x + y - z = 8\n",
        "# -3x - y + 2z = -11\n",
        "# -2x + y + 2z = -3\n",
        "\n",
        "# Matriks koefisien A (3x3)\n",
        "A = np.array([[2.0, 1.0, -1.0],\n",
        "              [-3.0, -1.0, 2.0],\n",
        "              [-2.0, 1.0, 2.0]], dtype=float)\n",
        "\n",
        "# Vektor konstanta b (3x1)\n",
        "b = np.array([8.0, -11.0, -3.0], dtype=float)\n",
        "\n",
        "print(\"\\nMatriks Koefisien (A):\")\n",
        "print(A)\n",
        "print(\"\\nVektor Konstanta (b):\")\n",
        "print(b)\n",
        "# Cell 3: Mendefinisikan fungsi Eliminasi Gauss (Forward Elimination & Back Substitution)\n",
        "def selesaikan_spltv(A_mat, b_vec):\n",
        "    n = len(b_vec)\n",
        "\n",
        "    # Menggabungkan matriks A dan b menjadi Augmented Matrix (M)\n",
        "    M = np.hstack([A_mat, b_vec.reshape(-1, 1)])\n",
        "    print(\"\\nMatriks Augmented Awal [A | b]:\")\n",
        "    print(M)\n",
        "\n",
        "    # 1. Proses Forward Elimination (Membentuk matriks segitiga atas)\n",
        "    for i in range(n):\n",
        "        # Cek elemen pivot untuk menghindari pembagian dengan nol\n",
        "        if M[i, i] == 0.0:\n",
        "            raise ValueError(\"Terjadi pembagian dengan nol pada elemen pivot.\")\n",
        "\n",
        "        for j in range(i + 1, n):\n",
        "            faktor = M[j, i] / M[i, i]\n",
        "            # Operasi baris elementer\n",
        "            M[j, i:] = M[j, i:] - faktor * M[i, i:]\n",
        "\n",
        "    print(\"\\nMatriks Setelah Eliminasi Maju (Segitiga Atas):\")\n",
        "    print(M)\n",
        "\n",
        "    # 2. Proses Back Substitution (Mendapatkan nilai variabel)\n",
        "    x = np.zeros(n)\n",
        "    for i in range(n - 1, -1, -1):\n",
        "        x[i] = (M[i, -1] - np.dot(M[i, i+1:n], x[i+1:n])) / M[i, i]\n",
        "\n",
        "    return x\n",
        "\n",
        "# Menjalankan fungsi penyelesaian\n",
        "hasil_solusi = selesaikan_spltv(A, b)\n",
