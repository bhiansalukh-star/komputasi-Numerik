      "source": [
        "# Cell 1: Import library NumPy dan definisikan matriks persamaan SPLTV\n",
        "import numpy as np\n",
        "\n",
        "# Contoh SPLTV:\n",
        "# 2x + y - z = 8\n",
        "# -3x - y + 2z = -11\n",
        "# -2x + y + 2z = -3\n",
        "A = np.array([\n",
        "    [2.0, 1.0, -1.0],\n",
        "    [-3.0, -1.0, 2.0],\n",
        "    [-2.0, 1.0, 2.0]\n",
        "])\n",
        "b = np.array([8.0, -11.0, -3.0])\n",
        "\n",
        "print(\"Matriks Koefisien (A):\")\n",
        "print(A)\n",
        "print(\"\\nVektor Konstanta (b):\")\n",
        "print(b)\n"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "# Cell 2: Fungsi Eliminasi Gauss dengan Partial Pivoting dan Back Substitution\n",
        "def selesaikan_spltv(A_mat, b_vec):\n",
        "    n = len(b_vec)\n",
        "    # Menggabungkan matriks A dan b menjadi Augmented Matrix (M) bertipe float\n",
        "    M = np.hstack([A_mat.astype(float), b_vec.astype(float).reshape(-1, 1)])\n",
        "    print(\"Matriks Augmented Awal [A | b]:\")\n",
        "    print(M)\n",
        "\n",
        "    # 1. Proses Forward Elimination dengan Partial Pivoting\n",
        "    for i in range(n):\n",
        "        # Mencari baris dengan nilai mutlak terbesar di kolom i\n",
        "        baris_max = np.argmax(np.abs(M[i:, i])) + i\n",
        "        # Tukar baris jika baris dengan pivot terbesar bukan baris saat ini\n",
        "        if baris_max != i:\n",
        "            M[[i, baris_max]] = M[[baris_max, i]]\n",
        "\n",
        "        # Cek apakah nilai pivot mendekati nol (toleransi numerik)\n",
        "        if np.abs(M[i, i]) < 1e-9:\n",
        "            if np.abs(M[i, -1]) > 1e-9:\n",
        "                raise ValueError(\"Sistem Persamaan Linear tidak memiliki solusi (Inconsistent/Singular).\")\n",
        "            else:\n",
        "                raise ValueError(\"Sistem Persamaan Linear memiliki solusi tak hingga (Dependent/Singular).\")\n",
        "\n",
        "        # Eliminasi elemen di bawah pivot\n",
        "        for j in range(i + 1, n):\n",
        "            faktor = M[j, i] / M[i, i]\n",
        "            M[j, i:] = M[j, i:] - faktor * M[i, i:]\n",
        "\n",
        "    print(\"\\nMatriks Setelah Eliminasi Maju (Segitiga Atas):\")\n",
        "    print(M)\n",
        "\n",
        "    # 2. Proses Back Substitution\n",
        "    x = np.zeros(n)\n",
        "    for i in range(n - 1, -1, -1):\n",
        "        if np.abs(M[i, i]) < 1e-9:\n",
        "            raise ValueError(\"Matriks terdeteksi singular saat substitusi balik.\")\n",
        "        x[i] = (M[i, -1] - np.dot(M[i, i+1:n], x[i+1:n])) / M[i, i]\n",
        "\n",
        "    return x\n",
        ""
      ],
