      "source": [
        "# Cell 3: Menjalankan fungsi penyelesaian SPLTV dan menampilkan hasil\n",
        "try:\n",
        "    hasil_solusi = selesaikan_spltv(A, b)\n",
        "    print(\"\\n=== HASIL AKHIR PENYELESAIAN SPLTV ===\")\n",
        "    print(f\"Nilai x = {hasil_solusi[0]:.2f}\")\n",
        "    print(f\"Nilai y = {hasil_solusi[1]:.2f}\")\n",
        "    print(f\"Nilai z = {hasil_solusi[2]:.2f}\")\n",
        "except ValueError as e:\n",
        "    print(f\"\\n[TERDETEKSI ERROR/SINGULAR]: {e}\")"
